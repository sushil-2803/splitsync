# Backend
DOCKERHUB_NAMESPACE=your-dockerhub-username
IMAGE_TAG=latest
POSTGRES_DB=splitsync
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/splitsync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=splitSyncSession
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PORT=3000

# Frontend
VITE_GOOGLE_CLIENT_ID=
# Empty uses /api through the Vite or Nginx proxy.
VITE_API_URL=

# Local Docker (docker-compose.yml); independent of development/production origins.
LOCAL_FRONTEND_ORIGIN=http://localhost:5003
LOCAL_COOKIE_SECURE=false
LOCAL_COOKIE_SAME_SITE=lax
LOCAL_SESSION_COOKIE_NAME=splitSyncDockerSession
# Empty sends /api requests through the frontend container's Nginx proxy.
LOCAL_VITE_API_URL=
# Use the included PostgreSQL container. For a host database, set its host and port.
POSTGRES_URL=postgres
POSTGRES_PORT=5432
